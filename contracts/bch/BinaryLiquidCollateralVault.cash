pragma cashscript ^0.14.0;

/**
 * @title BinaryLiquidCollateralVault (Per-User Non-Custodial BCH Lending Collateral Covenant)
 * @author BinaryLiquid Protocol / DrianOps
 * @notice Deterministic P2SH32 CashScript Smart Contract Vault (`bchtest:p...` / `bitcoincash:p...`)
 * dedicated to each borrower's Bitcoin Cash (BCH) lockingBytecode, with ZERO EOA private keys.
 *
 * SECURITY INVARIANTS (BCH Native UTXO Introspection):
 * 1. User-Bound Anti-Theft Invariant: Even with a valid Watchman signature, the BCH VM physically
 *    enforces `tx.outputs[0].lockingBytecode == borrowerLockingBytecode` — collateral BCH can NEVER
 *    be withdrawn to any address other than the borrower's own wallet.
 * 2. Solvency Gate: Requires Schnorr signature from The Watchman Sentinel (`watchmanPk`) after verifying
 *    Health Factor >= 1.15 (or zero remaining debt).
 * 3. Value Conservation & Covenant State Continuation: Enforces `withdrawSats + returnToVaultSats >= inputSats`
 *    and forces remaining collateral (`returnToVaultSats >= 546`) back into this exact P2SH32 Covenant.
 */
contract BinaryLiquidCollateralVault(
    pubkey watchmanPk,
    bytes borrowerLockingBytecode
) {
    function releaseCollateral(sig watchmanSig, int withdrawSats, int returnToVaultSats) {
        // 1. Verify solvency attestation from The Watchman Sentinel
        require(checkSig(watchmanSig, watchmanPk));
        require(withdrawSats >= 546);
        require(returnToVaultSats >= 0);

        // 2. Ensure zero satoshis from this Covenant input leak outside borrower payout + vault continuation
        int inputSats = tx.inputs[this.activeInputIndex].value;
        require(withdrawSats + returnToVaultSats >= inputSats);

        // 3. Enforce Output #0 delivers withdrawn BCH strictly to the borrower's own wallet
        require(tx.outputs[0].lockingBytecode == borrowerLockingBytecode);
        require(tx.outputs[0].value >= withdrawSats);

        // 4. Covenant State Continuation: Force remaining collateral back into this exact Vault
        if (returnToVaultSats >= 546) {
            bytes vaultBytecode = tx.inputs[this.activeInputIndex].lockingBytecode;
            require(tx.outputs[1].lockingBytecode == vaultBytecode);
            require(tx.outputs[1].value >= returnToVaultSats);
        }
    }
}
