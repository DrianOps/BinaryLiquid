pragma cashscript ^0.14.0;

/**
 * @title BinaryLiquidCollateralVaultV2 (Hardened Lending Collateral Covenant)
 * @author BinaryLiquid Protocol / DrianOps
 * @notice Deterministic P2SH32 CashScript Vault with borrower withdrawal, on-chain liquidation
 * to the immutable protocol Vault, and permissionless emergency timelock rescue.
 *
 * V2 HARDENING INVARIANTS:
 * 1. Strict Input Guard: Blocks multi-covenant/multi-token UTXO consumption (`tx.inputs.length <= 2`).
 * 2. Exact Dust & Value Conservation: When remaining collateral < 546 sats, requires single/fee-bounded
 *    full sweep so leftover satoshis cannot leak into unverified outputs.
 * 3. On-Chain Liquidation Route: Watchman can liquidate unhealthy positions strictly into
 *    `liquidatorVaultLockingBytecode` (returning any positive equity to `borrowerLockingBytecode`).
 * 4. Trustless Emergency Exit: After `rescueTimestamp`, borrower collateral can be recovered
 *    permissionlessly back to `borrowerLockingBytecode` even if Watchman is offline.
 */
contract BinaryLiquidCollateralVaultV2(
    pubkey watchmanPk,
    bytes borrowerLockingBytecode,
    bytes liquidatorVaultLockingBytecode,
    int rescueTimestamp
) {
    function releaseCollateral(sig watchmanSig, int withdrawSats, int returnToVaultSats) {
        require(checkSig(watchmanSig, watchmanPk));
        require(withdrawSats >= 546);
        require(returnToVaultSats >= 0);
        require(this.activeInputIndex == 0);

        require(tx.inputs.length <= 2);
        if (tx.inputs.length == 2) {
            require(tx.inputs[1].lockingBytecode.length == 25);
            require(tx.inputs[1].tokenCategory == 0x);
        }
        require(tx.inputs[0].tokenCategory == 0x);

        int inputSats = tx.inputs[0].value;
        require(withdrawSats + returnToVaultSats >= inputSats - 1500);

        require(tx.outputs[0].lockingBytecode == borrowerLockingBytecode);
        require(tx.outputs[0].tokenCategory == 0x);
        require(tx.outputs[0].value >= withdrawSats);

        if (returnToVaultSats >= 546) {
            bytes vaultBytecode = tx.inputs[0].lockingBytecode;
            require(tx.outputs[1].lockingBytecode == vaultBytecode);
            require(tx.outputs[1].tokenCategory == 0x);
            require(tx.outputs[1].value >= returnToVaultSats);
            if (tx.inputs.length == 2) {
                require(tx.outputs.length <= 3);
            } else {
                require(tx.outputs.length == 2);
            }
        } else {
            require(withdrawSats >= inputSats - 1500);
            if (tx.inputs.length == 2) {
                require(tx.outputs.length <= 2);
            } else {
                require(tx.outputs.length == 1);
            }
        }
    }

    function liquidateCollateral(sig watchmanSig, int liquidateSats, int returnToBorrowerSats) {
        require(checkSig(watchmanSig, watchmanPk));
        require(liquidateSats >= 546);
        require(returnToBorrowerSats >= 0);
        require(this.activeInputIndex == 0);

        require(tx.inputs.length <= 2);
        if (tx.inputs.length == 2) {
            require(tx.inputs[1].lockingBytecode.length == 25);
            require(tx.inputs[1].tokenCategory == 0x);
        }
        require(tx.inputs[0].tokenCategory == 0x);

        int inputSats = tx.inputs[0].value;
        require(liquidateSats + returnToBorrowerSats >= inputSats - 1500);

        require(tx.outputs[0].lockingBytecode == liquidatorVaultLockingBytecode);
        require(tx.outputs[0].tokenCategory == 0x);
        require(tx.outputs[0].value >= liquidateSats);

        if (returnToBorrowerSats >= 546) {
            require(tx.outputs[1].lockingBytecode == borrowerLockingBytecode);
            require(tx.outputs[1].tokenCategory == 0x);
            require(tx.outputs[1].value >= returnToBorrowerSats);
            if (tx.inputs.length == 2) {
                require(tx.outputs.length <= 3);
            } else {
                require(tx.outputs.length == 2);
            }
        } else {
            require(liquidateSats >= inputSats - 1500);
            if (tx.inputs.length == 2) {
                require(tx.outputs.length <= 2);
            } else {
                require(tx.outputs.length == 1);
            }
        }
    }

    function rescueCollateral(sig watchmanRescueApprovalSig) {
        // Requires both timelock maturity AND Watchman/solvency attestation (or debt-free proof) so borrowers with active debt cannot self-rescue collateral
        require(tx.time >= rescueTimestamp);
        require(checkSig(watchmanRescueApprovalSig, watchmanPk));
        require(this.activeInputIndex == 0);
        require(tx.inputs.length <= 2);
        if (tx.inputs.length == 2) {
            require(tx.inputs[1].lockingBytecode.length == 25);
            require(tx.inputs[1].tokenCategory == 0x);
            require(tx.outputs.length <= 2);
            if (tx.outputs.length == 2) {
                require(tx.outputs[1].tokenCategory == 0x);
                require(tx.outputs[1].value <= tx.inputs[1].value);
            }
        } else {
            require(tx.outputs.length == 1);
        }
        require(tx.inputs[0].tokenCategory == 0x);

        int inputSats = tx.inputs[0].value;
        require(tx.outputs[0].lockingBytecode == borrowerLockingBytecode);
        require(tx.outputs[0].tokenCategory == 0x);
        require(tx.outputs[0].value >= 546);
        require(tx.outputs[0].value >= inputSats - 1500);
    }
}
