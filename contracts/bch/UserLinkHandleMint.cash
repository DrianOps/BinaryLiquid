pragma cashscript ^0.14.0;

/**
 * @title UserLinkHandleMint (Anti-Spam Tiered Commit-Reveal CashTokens Handle Minter Covenant)
 * @author BinaryLiquid Protocol / DrianOps
 * @notice Bitcoin Cash P2SH-32 covenant holding a CashTokens Minting NFT (`0x02` capability) that
 *         mints immutable `@handle` NFTs (`UL1:<handle>`) with VM-enforced anti-spam tiered pricing
 *         by handle length and commit-reveal frontrunning protection.
 *
 * ANTI-SPAM PRICING TIERS (enforced directly by BCH VM consensus):
 * - 1..3 chars (Ultra-Rare): `tier13Sats`
 * - 4 chars    (Premium):    `tier4Sats`
 * - 5 chars    (Short):      `tier5Sats`
 * - 6..32 chars (Standard):  `tier6PlusSats`
 */
contract UserLinkHandleMint(
    bytes treasuryLockingBytecode,
    int tier13Sats,
    int tier4Sats,
    int tier5Sats,
    int tier6PlusSats,
    bytes32 commitHash,
    int minRevealTime
) {
    /**
     * @notice Reveals a committed handle and mints an immutable CashToken NFT (`UL1:<handle>`)
     *         to `recipientLockingBytecode` while preserving the Minting NFT inside this covenant.
     */
    function mintHandle(bytes handleBytes, bytes32 commitSalt, bytes recipientLockingBytecode) {
        require(this.activeInputIndex == 0);
        require(tx.time >= minRevealTime);

        int handleLen = handleBytes.length;
        require(handleLen >= 1 && handleLen <= 32);

        // Anti-frontrunning commit-reveal verification
        require(hash256(commitSalt + handleBytes + recipientLockingBytecode) == commitHash);

        // Input #0 must hold the CashTokens Minting NFT (32-byte category + 0x02 minting capability)
        bytes mintCat = tx.inputs[0].tokenCategory;
        require(mintCat.length == 33);
        bytes baseCategory, bytes capability = mintCat.split(32);
        require(capability == 0x02);

        // Guard auxiliary buyer BCH payment inputs
        require(tx.inputs.length >= 2 && tx.inputs.length <= 3);
        require(tx.inputs[1].tokenCategory == 0x);
        if (tx.inputs.length == 3) {
            require(tx.inputs[2].tokenCategory == 0x);
        }

        // Compute length-tiered anti-spam fee in satoshis
        int requiredFee = tier6PlusSats;
        if (handleLen <= 3) {
            requiredFee = tier13Sats;
        } else if (handleLen == 4) {
            requiredFee = tier4Sats;
        } else if (handleLen == 5) {
            requiredFee = tier5Sats;
        }
        require(requiredFee >= 546);

        // Output #0: Force Minting NFT back into this exact covenant bytecode (never escapes!)
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].tokenCategory == mintCat);
        require(tx.outputs[0].tokenAmount == 0);
        require(tx.outputs[0].value >= 1000);

        // Output #1: Mint immutable Handle NFT (`UL1:` prefix = 0x554c313a + handleBytes) to Buyer
        require(tx.outputs[1].lockingBytecode == recipientLockingBytecode);
        require(tx.outputs[1].tokenCategory == baseCategory);
        require(tx.outputs[1].nftCommitment == 0x554c313a + handleBytes);
        require(tx.outputs[1].tokenAmount == 0);
        require(tx.outputs[1].value >= 800);

        // Output #2: Enforce tiered anti-spam BCH payment strictly to Treasury
        require(tx.outputs[2].lockingBytecode == treasuryLockingBytecode);
        require(tx.outputs[2].tokenCategory == 0x);
        require(tx.outputs[2].value >= requiredFee);

        // Optional Output #3: Pure BCH change back to Buyer
        require(tx.outputs.length >= 3 && tx.outputs.length <= 4);
        if (tx.outputs.length == 4) {
            require(tx.outputs[3].tokenCategory == 0x);
        }
    }
}
