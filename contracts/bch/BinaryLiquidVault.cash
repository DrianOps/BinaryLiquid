pragma cashscript ^0.14.0;

/**
 * @title BinaryLiquidVault (Bitcoin Cash CashTokens Liquidity Pool Covenant)
 * @author BinaryLiquid Protocol / DrianOps
 * @notice 100% Non-Custodial Cross-Chain Liquidity Covenant for Bitcoin Cash CashTokens (PUSD).
 *
 * SECURITY INVARIANTS (BCH UTXO Introspection):
 * 1. Zero-Custody Pool: Funds live inside a P2SH32 Covenant with no EOA private key.
 * 2. Watchman Attestation: Requires Schnorr signature from The Watchman Sentinel (`watchmanPk`).
 * 3. On-Chain Circuit Breaker: Enforces `payoutAmount <= maxSinglePayout` inside VM script.
 * 4. Covenant State Continuation: Mathematically forces 100% of remaining CashTokens (`inputTokens - payoutAmount`)
 *    back into the exact same Covenant bytecode (`tx.outputs[1].lockingBytecode == activeLockingBytecode`).
 */
contract BinaryLiquidVault(
    pubkey watchmanPk,
    int maxSinglePayout
) {
    function release(sig watchmanSig, bytes recipientLockingBytecode, int payoutAmount) {
        // 1. Verify cryptographic attestation from The Watchman Sentinel
        require(checkSig(watchmanSig, watchmanPk));

        // 2. Enforce on-chain Circuit Breaker bounds
        require(payoutAmount > 0);
        require(payoutAmount <= maxSinglePayout);

        // 3. Read active CashToken category and pool balance via native UTXO introspection
        bytes poolCategory = tx.inputs[this.activeInputIndex].tokenCategory;
        int poolBalance = tx.inputs[this.activeInputIndex].tokenAmount;
        require(poolBalance >= payoutAmount);

        // 4. Enforce Output #0 delivers exact CashTokens to recipient
        require(tx.outputs[0].lockingBytecode == recipientLockingBytecode);
        require(tx.outputs[0].tokenCategory == poolCategory);
        require(tx.outputs[0].tokenAmount == payoutAmount);

        // 5. Covenant State Continuation: Force remaining pool liquidity back into this exact Vault
        int remainingBalance = poolBalance - payoutAmount;
        if (remainingBalance > 0) {
            bytes vaultBytecode = tx.inputs[this.activeInputIndex].lockingBytecode;
            require(tx.outputs[1].lockingBytecode == vaultBytecode);
            require(tx.outputs[1].tokenCategory == poolCategory);
            require(tx.outputs[1].tokenAmount >= remainingBalance);
        }
    }
}
