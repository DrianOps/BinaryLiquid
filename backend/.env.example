# ==============================================================================
# BinaryLiquid Stablecoin Bridge & AMM Factory - Configuration Environment
# Designed for Bitcoin Cash CashTokens (BLAZE $750 PUSD Hackathon) & Cross-Chain Swaps
# ==============================================================================

# Server Network Configuration
PORT=3001
HOST=0.0.0.0
NETWORK=mainnet

# Protocol Fee & Economics (0.3% protocol fee total, 0.2% to LPs, 0.1% to Treasury)
FEE_PERCENTAGE=0.003
MIN_SWAP_AMOUNT=1.0
MAX_SWAP_AMOUNT=100000.0

# Database & Cache (PostgreSQL + Redis with in-memory resilience fallback)
PGHOST=localhost
PGPORT=5432
PGDATABASE=binaryliquid_db
PGUSER=binaryliquid_user
PGPASSWORD=your_secure_pg_password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Bitcoin Cash Configuration (Mainnet or Chipnet)
BCH_NETWORK=mainnet
BCH_HOT_WALLET_WIF=your_bch_hot_wallet_wif_here
BCH_HOT_WALLET_ADDRESS=bitcoincash:qpnfz2nh7uy8a2ythr2z7am5vcxr28g43qkl20t4xm
BCH_TREASURY_ADDRESS=bitcoincash:qqgm9rel5xlyhwt3r6n8uq9fxk5zzxrcavaal6aw8v
BCH_COLD_TREASURY_ADDRESS=bitcoincash:qqgm9rel5xlyhwt3r6n8uq9fxk5zzxrcavaal6aw8v
BCH_MAINNET_TREASURY_ADDRESS=bitcoincash:qqgm9rel5xlyhwt3r6n8uq9fxk5zzxrcavaal6aw8v

# CashTokens Categories (Official ParyonUSD PUSD & MonetizeUSD MUSD)
PUSD_CATEGORY=a5c0b1f900000000000000000000000000000000000000000000000000000000
MUSD_CATEGORY=b7d0c2e800000000000000000000000000000000000000000000000000000000

# EVM Configuration (Polygon PoS Mainnet - Chain ID 137)
EVM_CHAIN_NAME=Polygon PoS Mainnet
