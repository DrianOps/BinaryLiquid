EVM_HOT_WALLET_ADDRESS=0x143cA3A5116835d94573C700320B9FEdFf846eF9
EVM_TREASURY_ADDRESS=0x143cA3A5116835d94573C700320B9FEdFf846eF9
EVM_COLD_TREASURY_ADDRESS=0x143cA3A5116835d94573C700320B9FEdFf846eF9
EVM_USDC_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
EVM_USDT_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F

# Solana Configuration (Mainnet-Beta)
