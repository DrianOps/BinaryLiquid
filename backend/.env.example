# ============================================================================
# BinaryLiquid Sovereign Bridge — Enterprise Environment Configuration
# Copy this file to `backend/.env` and set permissions: `chmod 600 backend/.env`
# ============================================================================

# 1. Server, Network & Cryptographic Session Security
PORT=3001
HOST=127.0.0.1
NODE_ENV=production
NETWORK=testnet
CORS_ORIGINS=https://bliquid.xyz,https://www.bliquid.xyz,http://localhost:5173
SESSION_HMAC_SECRET=replace_with_64_char_random_hex_secret
ADMIN_API_KEY=replace_with_64_char_random_hex_admin_key

# 2. Protocol Economics (0.3% = 0.003)
FEE_PERCENTAGE=0.003
MIN_SWAP_AMOUNT=0.01
MAX_SWAP_AMOUNT=50000.0

# 3. Database & Distributed Cache (PostgreSQL & Redis)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=binaryliquid_db
PGUSER=binaryliquid_user
PGPASSWORD=replace_with_strong_postgres_password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 4. Bitcoin Cash Non-Custodial CashScript Covenants (Mainnet & Chipnet)
