SIMULATE_IF_NO_FUNDS=false

# Auto-Sweeper Engine (Secures surplus funds to cold vault automatically)
SWEEPER_ENABLED=true
SWEEPER_INTERVAL_MS=60000
HOT_WALLET_MAX_PUSD=5000
HOT_WALLET_MAX_USDC=5000
HOT_WALLET_MAX_USDT=5000
HOT_WALLET_MAX_BCH=5
SWEEPER_MIN_TRIGGER_USD=200
